
// lambda
2 [ 2 * ] apply

// function with type annotation
: triple   ( S int -- S int )  3 * ;

3 triple
dup triple

: even?   ( S int -- S bool )  dup 0 == [ drop #t ] [ 1 - even? ! ] if ;

0 even? "is even" "is not even" ?
1 even? "is even" "is not even" ?
7 even? "is even" "is not even" ?
8 even? "is even" "is not even" ?
