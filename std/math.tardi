
exports:
    1+ 1- abs check-bounds max min zero? ;


: max   ( int int -- int )  [ > ] 2keep ? ;
: min   ( int int -- int )  [ < ] 2keep ? ;
: abs   ( int -- int )      dup 0 < [ -1 * ] when ;
: 1+    ( int -- int )      1 + ;
: 1-    ( int -- int )      1 - ;

/// checks that min <= n <= max
/// n min max -- n/#f
: check-bounds
    ( int int int -- a )
    pick < [
        2drop #f
    ] [
        dupd < [
            drop #f
        ] when
    ] if ;

/// n -- ?
: zero?   ( int -- bool )  0 == ;
