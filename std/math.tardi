
exports:
    1+ 1- abs check-bounds max min zero? ;


: max   ( S int int -- S int )  [ > ] 2keep ? ;
: min   ( S int int -- S int )  [ < ] 2keep ? ;
: abs   ( S int -- S int )      dup 0 < [ -1 * ] when ;
: 1+    ( S int -- S int )      1 + ;
: 1-    ( S int -- S int )      1 - ;

/// checks that min <= n <= max
/// n min max -- n/#f
: check-bounds
    ( S int int int -- S a )
    pick < [
        2drop #f
    ] [
        dupd < [
            drop #f
        ] when
    ] if ;

/// n -- ?
: zero?   ( S int -- S bool )  0 == ;
