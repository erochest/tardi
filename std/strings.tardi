
uses: std/math
uses: std/vectors
uses: std/_strings

exports:
    <string> >string utf>string concat nth >utf8 empty? in? starts-with?
    ends-with? index-of? length replace-all split split-all split-at
    split-whitespace lines strip-start strip-end substring >lowercase
    >uppercase utf8>digit parse-int utf8>string chunk-on repeat-string
    pad0 ;

/// utf8 -- int
: utf8>digit   ( int -- int )
    48 -
    0 9 check-bounds ;

/// accum n -- accum'
: accumulate-place   ( int int -- int )  swap 10 * + ;

/// s -- i
: parse-int   ( str -- int )
    0
    swap >utf8
    [
        utf8>digit
        accumulate-place
    ] each ;

/// str|#f -- ?
: at-end?   ( a -- bool )
    [
        dup #f ==
        dup [ nip ] when
    ] [ empty? ] || ;

/// str n -- vector/str
: chunk-on   ( str int -- vec )
    { } -rot
    [ over at-end? ! ] [
        [
            split-at
            [ over push! ] dip
        ] keep
    ] while
    2drop ;

: repeat-test    ( int -- int bool )  dup 0 > ;
: repeat-iter    ( int -- int )       1 - ;
: repeat-extend  ( str str -- str str str )  dupd concat ;

/// times string -- string
/// repeats a string times times
: repeat-string   ( int str -- str )
    "" rot
    [ repeat-test ] [
      [ repeat-extend ] dip
      repeat-iter
    ] while
    drop nip ;

/// string width -- string
/// this pads a string with '0' to be width
: pad0   ( str int -- str )
    over length -
    dup 0 > [
        "0" repeat-string
        swap concat
    ] [
        drop
    ] if ;
