
uses: std/_hashmaps
uses: std/_vectors
uses: std/math

exports:
    <vector> 1vector 2vector 3vector concat deep-push! each each2 empty?
    first first2 fourth in? index-of? join last length map map2 nth pop!
    pop-left! push! push-left! reduce second set-nth! sort! subvector third
    sum frequencies window-pairs all? any? max filter partition [..] [..) [0..)
    in-bounds? remove-at lastn split-at count combine flatten ;

: 1vector   ( a -- vec )       { } [ push! ] keep ;
: 2vector   ( a b -- vec )     { } tuck push-left! tuck push-left! ;

/// a b c -- xs
: 3vector   ( a b c -- vec )
  <vector>
  tuck push-left!
  tuck push-left!
  tuck push-left! ;

: first    ( vec -- a )   0 swap nth ;
: second   ( vec -- a )   1 swap nth ;
: third    ( vec -- a )   2 swap nth ;
: fourth   ( vec -- a )   3 swap nth ;

: first2    ( vec -- a b )  [ first ] [ second ] bi ;

: last     ( vec -- a )  [ length 1 - ] keep nth ;

: empty?   ( vec -- bool )  length 0 == ;

: each-init-index-limit   ( vec a -- a vec int int )  swap dup length 0 ;
: each-init-state         ( vec a -- a vec int int )  each-init-index-limit ;
: each-more?              ( int int -- int int bool )  2dup > ;
: each-get-item           ( vec int int -- a vec int int )  -rot [ [ nth ] 2keep ] dip rot ;
: each-clear-apply        ( S a b c d e -- S b c d | effect )  [ swap [ apply ] keep ] 3dip ;
: each-next               ( int -- int )  1 + ;

: each-loop   ( S a vec int int -- S a vec int int )
    [ each-more? ] [
        each-get-item
        each-clear-apply
        each-next
    ] while ;

: each-cleanup   ( a b c d -- )  4drop ;

: each   ( S vec a -- S | effect )  each-init-state each-loop each-cleanup ;

: find-min-length   ( vec vec -- int )  [ length ] bi@ min ;
: float-lists       ( a b c d -- a d b c )  -rot ;
: nth-both          ( int vec vec -- int a b )  overd nth [ dupd nth ] dip ;
: clean-apply       ( a b c d -- a d | effect )  [ [ apply ] keep ] dip ;
: arrange-apply     ( S a b c d -- S a b c d | effect )  [ nth-both 2swap clean-apply ] 2keep ;

: each2-init        ( S vec vec a -- S a vec vec int int )  -rot 2dup find-min-length 0 swap ;
: each2-continue?   ( int int -- int int bool )  2dup < ;
: each2-apply       ( S a b c d e -- S a b c d e | effect )  [ float-lists arrange-apply ] dip ;
: each2-restack     ( a b c d e -- a c d b e )  rotd ;
: each2-cleanup     ( a b c d e -- )  5drop ;

/// xs ys quot --
: each2   ( S vec vec a -- S | effect )
    each2-init
    [ each2-continue? ] [
        each2-apply
        each2-restack
        [ 1+ ] dip
    ] while
    each2-cleanup ;

: map-init        ( vec a -- vec a vec )  { } spin ;
: map-init-step   ( vec a b -- b a vec )  spin ;
: map-clear-apply ( S a b vec -- S a' b vec | effect )  [ [ apply ] keep ] dip ;
: map-push!       ( a b vec -- vec b )  swap [ [ push! ] keep ] dip ;

: map-loop   ( S vec a vec -- S vec a | effect )
    [
        map-init-step
        map-clear-apply
        map-push!
    ] each ;

: map-cleanup   ( a vec -- vec )  drop ;

: map   ( S vec a -- S vec | effect )  map-init map-loop map-cleanup ;

/// xs ys quot -- zs
: map2   ( S vec vec a -- S vec | effect )
    { } 2swap
    [
        reach apply
        over push!
    ] each2
    nip ;

/// vector init ( accum item -- accum ) -- accum
: reduce   ( S vec a b -- S a | effect )
    rot
    [ swap [ apply ] keep ] each
    drop ;

: sum   ( vec -- int )  0 [ + ] reduce ;

: deep-push!   ( vec a b -- vec a )  pick push! ;

: inc   ( hashmap a -- hashmap )
    swap 2dup get
    [ 1+ ] [ drop 1 ] if
    swap set! ;

: frequencies   ( vec -- hashmap )
    <hashmap>
    [ dupd inc ] reduce ;

: window/setup    ( vec -- bool vec vec )  #f { } rot ;
: window/first?   ( bool vec a -- vec bool a bool )  swapd over #f? ;
: window/store    ( vec bool a -- a vec )  nip swap ;
: window/pair     ( vec bool a -- vec )    2vector over push! ;

: window-pairs   ( S vec -- S vec )
    window/setup
    [
        window/first? [
            window/store
        ] [
            [ window/pair ] keep
            swap
        ] if
    ] each
    nip ;

: all?   ( S vec a -- S bool | effect )
    swap #t
    [
        -rot
        [ [ apply ] keep ] dip
        rot and
    ] reduce
    nip ;

: any?   ( S vec a -- S bool | effect )
    swap #f
    [
        -rot
        [ [ apply ] keep ] dip
        rot or
    ] reduce
    nip ;

: clean-apply   ( S a b c -- S bool a b | effect )  swap [ swap [ apply ] keep ] dip ;
: filter?       ( S a b c -- S a b c bool | effect )  [ clean-apply ] keep rotd swap ;
: push-if!      ( S vec a bool -- S vec | effect )  [ over push! ] [ drop ] if ;
: (filter)      ( S a vec b -- S a b | effect )  [ filter? push-if! ] reduce ;
: filter        ( S vec a -- S vec | effect )  swap { } (filter) nip ;

: count   ( S vec a -- S int | effect )  filter vectors/length ;

: partition/setup       ( vec a -- a vec vec )  swap { } { } 2vector ;
: partition/test        ( S a b c -- S a b c bool | effect )  [ pick apply ] keep swap ;
: partition/get-accum   ( vec bool -- vec )  [ second ] [ first ] if ;
: partition/clean       ( a b -- a b )  nip first2 ;
: partition/store       ( S vec a bool -- S vec | effect )  overd partition/get-accum push! ;

: (partition)   ( S a vec b -- S a b | effect )  [ partition/test partition/store ] reduce ;

: partition   ( S vec a -- S vec vec | effect )  partition/setup (partition) partition/clean ;

: more]?   ( vec int int -- vec int int bool )  2dup >= ;
: store    ( vec int int -- vec int int )  [ pick push! ] keep ;

: [..]   ( int int -- vec )
    { } spin
    [ more]? ] [ store 1+ ] while
    2drop ;

: more)?   ( vec int int -- vec int int bool )  2dup > ;

: [..)   ( int int -- vec )
    { } spin
    [ more)? ] [ store 1+ ] while
    2drop ;

: [0..)   ( int -- vec )  0 swap [..) ;

: in-bounds?   ( vec int -- vec int bool )  2dup 0 rot length 1- check-bounds #f? ! ;

: preslice   ( int vec -- vec )  0 spin subvector ;
: postslice  ( int vec -- vec )  swap [ length ] keep subvector ;

: remove-at   ( vec int -- vec )
    in-bounds?
    [
        [ preslice ] [ 1+ postslice ] 2bi
        concat
    ] [ drop ] if ;

: indexes-from-end   ( vec int -- vec int int )
    over length
    swap dupd - ;

: invalid-start-index   ( int -- bool )  0 <= ;
: cleanup-indexes       ( a b -- )  2drop ;

: max   ( vec -- a )  dup first [ math/max ] reduce ;

: lastn   ( vec int -- vec )
    indexes-from-end
    dup invalid-start-index [ cleanup-indexes ] [
        spin subvector
    ] if ;

: split-prefix   ( int vec -- vec )  0 -rot subvector ;
: split-post     ( int vec -- vec )  [ length ] keep subvector ;
: split-at       ( int vec -- vec vec )  [ split-prefix ] [ split-post ] 2bi ;

: flatten   ( vec -- vec )  { } [ concat ] reduce ;

: combine-spread   ( vec a -- vec vec )  over [ dupd 2vector ] map nip ;

: combine   ( vec vec -- vec )
  swap
  [ combine-spread ] map
  nip
  flatten ;
