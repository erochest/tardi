uses: std/scanning
uses: std/vectors
uses: std/_hashmaps

exports:
    <hashmap> >hashmap >vector add! each empty? get H{ in? is-hashmap? keys
    length map set! values inc ;

/// hashmap literals:
/// H{ { "key1" 4 } { "key2" 5 } }
MACRO: H{ } scan-object-list >hashmap over vectors/push! ;

: keys   ( hashmap -- vec )  >vector [ first ] map ;

: values   ( hashmap -- vec )  >vector [ second ] map ;

: in?   ( a hashmap -- bool )  keys vectors/in? ;

// ( hashmap lambda:( k v -- ) -- )
: each   ( S hashmap a -- S | effect )  swap >vector [ dup vectors/empty? ! ] [
      [
        vectors/pop!
        [ first ] keep
        second
        rot
        [ apply ] keep
      ] keep
    ] while 2drop ;

// ( hashmap lambda:( v -- v' ) -- hashmap' )
: map   ( S hashmap a -- S hashmap | effect )  swap >vector [
        [ second ] keep first
        [ swap [ apply ] keep ] dip
        rot
        { } rot over push!
        swap over push!
    ] vectors/map
    >hashmap nip ;

: empty?   ( hashmap -- bool )  _hashmaps/length 0 == ;

: inc   ( hashmap a -- hashmap )
    swap 2dup get
    [ 1+ ] [ drop 1 ] if
    swap set! ;
