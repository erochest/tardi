/// The standard conditional.
///
/// ..s ? t:( ..s -- ..s' ) f:( ..s -- ..s' ) -- ..s'
///
/// This expects three items on the stack:
/// - a boolean
/// - a lambda to call if the boolean is `#t`
/// - a lambda to call if the boolean is `#f`
///
/// == 0 [ "zero" ] [ "non-zero" ] if
: if   ( S bool a b -- S | effect )  ? apply ;

: #f?   ( a -- bool )  #f == ;

/// `when` is `if` without the `else`.
/// ? if-true --
: when     ( S bool a -- S | effect )  [ ] if ;

/// ? quot --
: unless   ( S bool a -- S | effect )  [ ] swap if ;

/// ..s lambda x -- ..s' lambda x
: deep-apply   ( S a b -- S a b | effect )  dupd [ apply ] 2dip ;

/// ..s pred exec -- ..s' pred exec ?
: while-continue?   ( S a b -- S a b bool | effect )  deep-apply rot ! ;

/// pred exec --
: while-cleanup   ( a b -- )  2drop ;

/// `while` runs a lambda as long as a predicate lambda returns `#t`.
/// It's tested before each run of the execution lambda.
/// predicate execution --
: while   ( S a b -- S | effect )  [
    while-continue? [ while-cleanup break ] when
    swap deep-apply swap
    ] loop ;

: and   ( S bool a -- S bool | effect )       [ [ #t ] [ #f ] if ] [ drop #f ] if ;
: or    ( S bool a -- S bool | effect )        [ drop #t ] [ [ #t ] [ #f ] if ] if ;
: positive?  ( int -- bool )  0 > ;
: negative?  ( int -- bool )  0 < ;

/// lambda1 lambda2 -- ?
: ||
    ( S a b -- S bool | effect )
    [ apply ] dip swap
    [
        drop #t
    ] [
        apply
    ] if ;
